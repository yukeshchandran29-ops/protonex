# ── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
APP_URL=http://localhost:5173
API_URL=http://localhost:8787

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://protonex:protonex@localhost:5432/protonex?schema=public

# ── Auth ─────────────────────────────────────────────────────────────────
AUTH_SECRET=replace-with-openssl-rand-base64-32
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-32
JWT_REFRESH_SECRET=replace-with-openssl-rand-base64-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false

# ── Object storage (S3-compatible: AWS S3 or Cloudflare R2) ───────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=protonex-cad-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Email (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="ProtoNex <quotes@protonex.example>"

# ── Background jobs ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Geometry engine ──────────────────────────────────────────────────────
PYTHON_BIN=python3
