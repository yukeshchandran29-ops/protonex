# ── ProtoNex Server Configuration ─────────────────────────────────────────
NODE_ENV=development
PORT=8787
APP_URL=http://localhost:8787
API_URL=http://localhost:8787

# ── Email Settings (Optional) ──────────────────────────────────────────────
# Leave blank to automatically use the Ethereal Test Inbox (generates 1-click preview links).
# Or enter your Gmail / College SMTP credentials to send real emails with CAD attachments!
# Example for Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASS=your_16_digit_app_password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ProtoNex Fabrication <quotes@protonex.local>"

# ── Optional Python Path for STEP Analysis ──────────────────────────────────
PYTHON_BIN=python
